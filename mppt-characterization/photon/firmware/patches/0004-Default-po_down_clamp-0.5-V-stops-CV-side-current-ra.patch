From a416f879d0d4de6ca13fe220488f78102706befa Mon Sep 17 00:00:00 2001
From: Akhil Marri <akhilm28@stanford.edu>
Date: Mon, 5 Oct 2026 22:41:38 -0700
Subject: [PATCH 04/12] Default po_down_clamp 0.5 V: stops CV-side current ramp
 overshooting the source limit at low input voltage

---
 photon_fields.inc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/photon_fields.inc b/photon_fields.inc
index b1f1394..fe9b25b 100644
--- a/photon_fields.inc
+++ b/photon_fields.inc
@@ -21,6 +21,6 @@ TUNE(1115, po_settle_ticks, 2, 0, 99)       /* P&O: ticks ignored after each ste
 TUNE(1116, po_step_min, 12, 1, 500)         /* P&O: step after a reversal (~0.25 V) */
 TUNE(1117, po_step_max, 100, 1, 1000)       /* P&O: largest step after repeated same-direction gains (~2 V) */
 TUNE(1118, po_up_clamp, 24, 1, 1000)        /* P&O: goal may not exceed measured V by more than this */
-TUNE(1119, po_down_clamp, 100, 1, 2000)     /* P&O: goal may not fall below measured V by more than this */
+TUNE(1119, po_down_clamp, 24, 1, 2000)      /* P&O: goal may not fall below measured V by more than this (~0.5 V); larger values overshoot the source current limit */
 TUNE(1120, hold_v_raw, 0, 0, 5912)          /* 0 = track; otherwise hold this input voltage */
 TUNE(1121, stream, 0, 0, 1)                 /* 1 = send tracker debug frames on base+0xE1/0xE2 at 50 Hz */
