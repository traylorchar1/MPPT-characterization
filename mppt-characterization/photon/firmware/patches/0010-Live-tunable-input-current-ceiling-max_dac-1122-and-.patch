From dbebd5f922885cf87513c1edeb5b2c983a61ea4a Mon Sep 17 00:00:00 2001
From: Akhil Marri <akhilm28@stanford.edu>
Date: Wed, 7 Oct 2026 22:13:39 -0700
Subject: [PATCH 10/12] Live-tunable input current ceiling (max_dac, 1122) and
 array overcurrent trip (oc_arr_raw, 1123); defaults unchanged

---
 photon_fields.inc |  2 ++
 photon_service.c  |  1 +
 safety.c          |  3 ++-
 tracker.c         | 13 ++++++++++++-
 tracker.h         |  1 +
 5 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/photon_fields.inc b/photon_fields.inc
index fe9b25b..f63dd88 100644
--- a/photon_fields.inc
+++ b/photon_fields.inc
@@ -24,3 +24,5 @@ TUNE(1118, po_up_clamp, 24, 1, 1000)        /* P&O: goal may not exceed measured
 TUNE(1119, po_down_clamp, 24, 1, 2000)      /* P&O: goal may not fall below measured V by more than this (~0.5 V); larger values overshoot the source current limit */
 TUNE(1120, hold_v_raw, 0, 0, 5912)          /* 0 = track; otherwise hold this input voltage */
 TUNE(1121, stream, 0, 0, 1)                 /* 1 = send tracker debug frames on base+0xE1/0xE2 at 50 Hz */
+TUNE(1122, max_dac, 2023, 64, 2400)         /* input current ceiling, DAC counts (2023 ~ 7.5 A, ~3.7 mA/count); rev 3.2+ */
+TUNE(1123, oc_arr_raw, 8192, 1024, 9216)    /* array overcurrent trip, Photon-measured counts (8192 = 8.0 A, 9216 = 9.0 A) */
diff --git a/photon_service.c b/photon_service.c
index 14113cf..fe899ef 100644
--- a/photon_service.c
+++ b/photon_service.c
@@ -145,6 +145,7 @@ static uint32 WriteField(uint16 id, Value v) {
     if (id == 1109 && v.i >= photon_tuning.max_voltage_raw) return 3;
     if (id == 1110 && v.i <= photon_tuning.min_voltage_raw) return 3;
     ((int32 *)&photon_tuning)[id - TUNE_FIRST] = v.i;
+    if (id == 1122) TrackerApplyMaxDac();
     return 0;
   }
   f = Find(id);
diff --git a/safety.c b/safety.c
index e76311f..187445a 100644
--- a/safety.c
+++ b/safety.c
@@ -33,6 +33,7 @@ SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 #include "comparator.h"
 #include "state.pb.h"
 #include "params.pb.h"
+#include "photon_service.h"
 
 /******************************************************************************/
 /******************************************************************************/
@@ -91,7 +92,7 @@ void CheckSafety(void){
   }else if(state.batt_i_raw > max_current_batt){
     state.safety = SafetyEnum_BATT_OC;
     state.control = ErrorStateClosed(state.control); 
-  }else if(state.chan[0].i_raw > max_current_arr){
+  }else if(state.chan[0].i_raw > (max_current_arr = photon_tuning.oc_arr_raw)){
     state.safety = SafetyEnum_ARR_0_OC;
     state.control = ErrorStateClosed(state.control); 
   }else if(state.chan[1].i_raw > max_current_arr){
diff --git a/tracker.c b/tracker.c
index e39046c..2613a2a 100644
--- a/tracker.c
+++ b/tracker.c
@@ -99,7 +99,7 @@ void InitTracker(void){
   if(params.device.hw_rev >= PHOTON_3_2){
     // Rev 3.2+ has a 12 bit dac
     // https://www.wolframalpha.com/input/?i=16amps+*+2milliohms+*+4990%2F100+*+4096%2F2.048volts
-    MAXDAC = 2023;  // ~7.5 amp limit 
+    MAXDAC = photon_tuning.max_dac;  // default 2023, ~7.5 amp limit 
   }else{
     MAXDAC = (130 * ADC_FILT_LEN) << DAC_SHIFT; //~7.5A limit
   }
@@ -117,6 +117,17 @@ void InitTracker(void){
 /******************************************************************************/
 /******************************************************************************/
 
+// Apply a new input current ceiling without restarting the converter.
+void TrackerApplyMaxDac(void){
+  if(params.device.hw_rev >= PHOTON_3_2){
+    MAXDAC = photon_tuning.max_dac;
+    state.max_dac = MAXDAC;
+  }
+}
+
+/******************************************************************************/
+/******************************************************************************/
+
 int32 SwitchDirection(int32 dir){
   if(dir == TrackingDirectionEnum_UP){
     return(TrackingDirectionEnum_DOWN);
diff --git a/tracker.h b/tracker.h
index 3dfd1fe..f6d5306 100644
--- a/tracker.h
+++ b/tracker.h
@@ -91,6 +91,7 @@ SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 /*Functions*/
 
 void InitTracker(void);
+void TrackerApplyMaxDac(void);
 void TrackerStateMachine(void);
 void ControlVoltages(void);
 void CurveTrace(uint8 alg);
