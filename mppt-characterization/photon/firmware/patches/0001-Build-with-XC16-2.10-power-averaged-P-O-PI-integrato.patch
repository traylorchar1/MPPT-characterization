-    case 1000000: min_msg_divisor = 0; break;
-    default:      min_msg_divisor = 49; break;
-  }
-  msg_divisor = MAX(min_msg_divisor, params.comm.msg_divisor);
-
-  SendMessages(msg_divisor);
