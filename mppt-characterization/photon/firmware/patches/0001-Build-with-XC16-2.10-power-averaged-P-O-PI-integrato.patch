-    LED_G_TOG();
-    led_counter = 0;
-  }
-  TrackerStateMachine();
-
-  switch(params.comm.can_bitrate){
-    case 10000:   min_msg_divisor = 49; break;
-    case 20000:   min_msg_divisor = 39; break;
-    case 50000:   min_msg_divisor = 9; break;
-    case 100000:  min_msg_divisor = 4; break;
